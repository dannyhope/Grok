		"@tailwindcss/vite": "^4.1.18",
		"bits-ui": "^2.15.5",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"svelte-sonner": "^1.0.7",
